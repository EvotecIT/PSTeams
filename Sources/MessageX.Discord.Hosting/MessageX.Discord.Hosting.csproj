<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Title>MessageX Discord Hosting</Title>
    <Description>Verified Discord interaction and durable hosting adapters for MessageX.</Description>
    <AssemblyName>MessageX.Discord.Hosting</AssemblyName>
    <PackageId>MessageX.Discord.Hosting</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MessageX.Discord\MessageX.Discord.csproj" />
    <ProjectReference Include="..\MessageX.Hosting\MessageX.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>

